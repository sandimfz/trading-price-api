# Server
APP_ENV=development
HTTP_PORT=8080
WS_PORT=8081

# Database
DATABASE_URL=postgres://user:password@localhost:5432/trading_price_api?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Upstream data source (tvsocket)
UPSTREAM_WS_URL=wss://data.tradingview.com/socket.io/websocket
UPSTREAM_WS_ORIGIN=https://data.tradingview.com
UPSTREAM_SCANNER_URL=https://scanner.tradingview.com
DEFAULT_SYMBOLS=FOREXCOM:XAUUSD,FOREXCOM:XAGUSD,FOREXCOM:EURUSD

# Security
API_KEY_HASH_SALT=change-me-in-production
JWT_SECRET=change-me-in-production

# Rate limit default (per tier, req/menit)
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=1000